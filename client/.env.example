# The API server's address. Leave empty when running locally (Vite forwards /api to the server).
# On Vercel, set it to your Render service, e.g. https://eventinvito-api.onrender.com
VITE_API_URL=

# Optional. The address shown in the "Made with ♥ on EventInvito" footer on invitations.
# Leave empty to use the address the site is opened on (your Vercel address now, your domain later).
VITE_SITE_URL=
