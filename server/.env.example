# Copy this file to .env and fill in the values. Never commit .env.

# Port the API listens on (hosting providers usually set this for you)
PORT=5000

# The site's address. Guest links are built from it, so in production it must be
# your real https:// domain, e.g. https://eventinvito.lk
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventinvito?retryWrites=true&w=majority

# Long random secret for sign-in tokens and guest-link encryption (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everyone out, and existing guest links must be reset to be copied again.
JWT_SECRET=<long random string>
JWT_EXPIRES_IN=7d

# Photo uploads (optional). Free Cloudinary account → Dashboard → "API Keys".
# Leave empty to switch photo uploads off.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Extra site addresses allowed to call the API, comma-separated (optional),
# e.g. https://www.eventinvito.lk when CLIENT_URL is https://eventinvito.lk
ALLOWED_ORIGINS=

# Accounts. Anyone can sign up and publish one free card (a free design). Animated designs
# need a Premium credit, which you add on the admin page when a couple pays
# (npm run create-admin makes your first admin account).
# ALLOW_SIGNUP=false closes sign-up. SIGNUP_CREDITS = Premium invitations a new account gets
# (keep 0). LOCK_AFTER_EVENT=true closes paid accounts the day after their last event (off).
ALLOW_SIGNUP=
SIGNUP_CREDITS=0
LOCK_AFTER_EVENT=
# Shown on the Sign In / Create Account pages so couples can reach you (optional)
CONTACT_EMAIL=
CONTACT_PHONE=

# Production only:
# NODE_ENV=production   # also makes the server serve the built React app from client/dist
# TRUST_PROXY=1         # set when running behind a hosting proxy (Render, Railway, Nginx…)
